# .env.example (SAFE FOR PUBLIC GITHUB)

# Database Configuration
NEXTCLOUD_APP_MYSQL_PASSWORD=change_this_to_a_secure_password
NEXTCLOUD_APP_MYSQL_DATABASE=nextcloud
NEXTCLOUD_APP_MYSQL_USER=nextcloud
NEXTCLOUD_APP_MYSQL_HOST=db

# Cloudflare Tunnel Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_tunnel_token_here

# Dataset Storage Paths
NEXTCLOUD_APP_DATASET_DB=/path/to/your/db_storage
NEXTCLOUD_APP_DATASET_HTML=/path/to/your/html_storage

# Microsoft External Entra ID
ENTRA_CLIENT_ID=entry-guid-here
ENTRA_TENANT_ID=entry-tenant-id-here
ENTRA_CLIENT_SECRET=entry-client-secret-here

# Generate a random 32-character cookie secret
OAUTH2_COOKIE_SECRET=cookie-secret-here

# Linux Desktop Dataset Path
DESKTOP_APP_DATASET_CONFIG=/path/to/your/desktop_config
DESKTOP_VNC_PASSWORD=your_vnc_password_here